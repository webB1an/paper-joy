<view class="card" bindtap="open" role="button" aria-label="{{item.title}}"><image wx:if="{{item.coverUrl}}" class="cover" src="{{item.coverUrl}}" mode="aspectFit" lazy-load/><view wx:else class="state">暂无预览</view><view class="card-title">{{item.title}}</view><view class="meta">{{item.ageMin}}–{{item.ageMax}} 岁 · {{item.pageCount}} 页 · {{item.colorMode === "BW" ? "黑白打印" : "彩色打印"}}</view><view class="muted">{{item.summary}}</view><text class="chip">{{item.accessMode === "FREE" ? "免费领取" : "领取素材"}}</text></view>
