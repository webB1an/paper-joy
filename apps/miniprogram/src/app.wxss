page{background:#f8f6f2;color:#252733;font:30rpx -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.6}view,text,button,input,textarea{box-sizing:border-box}button{font-size:28rpx;border-radius:28rpx;margin:0;background:#fff;color:#252733;line-height:1.5;padding:23rpx 28rpx}button::after{border:0}button[disabled]{opacity:.48}.page{padding:26rpx 30rpx 220rpx;min-height:85vh}.hero{padding:20rpx 0 32rpx}.eyebrow{font-size:24rpx;color:#356ade;letter-spacing:3rpx}.title{font-size:52rpx;font-weight:700;line-height:1.3;word-break:break-all}.subtitle,.muted{color:#666975;font-size:26rpx}.section-title{font-size:35rpx;font-weight:650;margin:34rpx 0 20rpx}.glass{background:#fff;border:1rpx solid #e8e6e2;box-shadow:0 12rpx 40rpx #33333308;border-radius:32rpx}@supports(backdrop-filter:blur(12px)){.glass{background:rgba(255,255,255,.88);backdrop-filter:blur(12px)}}.row{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}.between{justify-content:space-between}.chip{padding:12rpx 23rpx;border-radius:99rpx;background:#eeece7;font-size:25rpx;display:inline-block;margin:0 12rpx 14rpx 0}.chip.active{background:#356ade;color:#fff}.primary{background:#356ade;color:#fff}.search{padding:24rpx 28rpx;margin:20rpx 0;color:#666975}.card{background:#fff;border:1rpx solid #e9e7e2;border-radius:30rpx;padding:20rpx;margin:20rpx 0;overflow:hidden}.cover{width:100%;height:390rpx;background:#f1f0ed;border-radius:18rpx}.card-title{font-size:34rpx;font-weight:650;line-height:1.4;margin:18rpx 0 9rpx;word-break:break-all}.meta{font-size:24rpx;color:#666975}.state{text-align:center;padding:70rpx 28rpx;color:#666975}.state button{margin-top:24rpx}.actions{display:flex;gap:16rpx;margin:26rpx 0}.actions button{flex:1}.body{white-space:pre-wrap;word-break:break-all}.preview{width:100%;margin:12rpx 0;background:white;border-radius:16rpx}.field{background:#fff;border:1rpx solid #ddd;border-radius:20rpx;padding:24rpx;width:100%;margin:20rpx 0}.link{color:#356ade}.foot{font-size:23rpx;color:#666975;margin-top:32rpx}.brand{width:90rpx;height:90rpx;border-radius:24rpx}.legal{font-size:28rpx;line-height:1.9}.provider{padding:30rpx}.spacer{height:20rpx}
