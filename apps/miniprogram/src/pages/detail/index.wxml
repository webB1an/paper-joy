<pj-nav title="素材详情" back/><view class="page"><view class="state" wx:if="{{loading}}">正在加载素材…</view><view class="state" wx:if="{{error}}">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{resource}}"><image wx:if="{{resource.coverUrl}}" class="cover" src="{{resource.coverUrl}}" mode="aspectFit"/><view class="title">{{resource.title}}</view><view class="subtitle">{{resource.summary}}</view><view class="row"><text class="chip">{{resource.ageMin}}–{{resource.ageMax}} 岁</text><text class="chip">{{resource.pageCount}} 页 · A4</text><text class="chip">{{resource.colorMode === 'BW' ? '黑白' : '彩色'}}</text><text class="chip">{{resource.hasAnswers ? '附答案' : '无答案'}}</text><text class="chip">{{resource.difficulty === 'EASY' ? '入门' : resource.difficulty === 'MEDIUM' ? '进阶' : '挑战'}}</text></view><view class="actions"><button bindtap="favorite">{{favorite ? '♥ 已收藏' : '♡ 收藏'}}</button><button class="primary" bindtap="claim">领取打印文件</button><button open-type="share">分享</button></view><view class="section-title">准备什么</view><view class="body"><text wx:for="{{resource.materials}}" wx:key="*this">{{item}}　</text></view><view class="section-title">怎么打印与使用</view><view class="body">{{resource.instructions}}</view><view class="section-title">内页预览</view><image wx:for="{{resource.previewUrls}}" wx:key="*this" class="preview" src="{{item}}" mode="widthFix" lazy-load data-url="{{item}}" bindtap="preview"/><view wx:if="{{!resource.previewUrls.length}}" class="state">暂无内页预览</view><view class="section-title">来源与授权</view><view wx:for="{{resource.sources}}" wx:key="url" class="card body">{{item.title}} · {{item.author}}<view class="muted">{{item.license}}</view><text selectable>{{item.url}}</text></view><button bindtap="feedback">反馈内容或链接问题</button><view class="foot">请遵循素材授权范围；剪刀等工具请由成人陪同使用。</view></block></view>
